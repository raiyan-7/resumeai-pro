# App Environment (development, production)
ENVIRONMENT=development

# Database settings (use sqlite locally, postgres/mysql in production)
DATABASE_URL=sqlite:///./resumeai.db

# JWT Configuration (generate a strong random secret in production)
# In production, this must not equal the development placeholder key.
JWT_SECRET=dev_placeholder_jwt_secret_change_me_before_deploying
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Project Metadata
PROJECT_NAME="ResumeAI Pro"

# CORS configuration (comma-separated origins for production API access security)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
